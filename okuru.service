[Unit]
Description=Okuru

[Service]
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
Type=simple
WorkingDirectory=/home/freebox/Okuru
EnvironmentFile=/home/freebox/Okuru/.env
ExecStart=/bin/bash -c 'exec /home/freebox/Okuru/Okuru > >(/usr/bin/tee -a /var/log/okuru.log) 2>&1'
User=freebox
Group=freebox
Restart=always
RestartSec=5s
LogNamespace=okuru
StandardOutput=journal
StandardError=journal
RuntimeDirectory=Okuru
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
Alias=Okuru.service
