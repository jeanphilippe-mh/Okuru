[Unit]
Description=Okuru
Requires=okuru-log-init.service
After=okuru-log-init.service
StartLimitIntervalSec=15min
StartLimitBurst=4

[Service]
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
Type=simple
WorkingDirectory=/home/freebox/Okuru
EnvironmentFile=/home/freebox/Okuru/.env
ExecStartPre=/bin/sh -c 'test -f /var/log/okuru.log && test ! -L /var/log/okuru.log && test -w /var/log/okuru.log'
ExecStart=/home/freebox/Okuru/Okuru --internal-log-supervisor
User=freebox
Group=freebox
KillMode=mixed
NotifyAccess=main
WatchdogSec=90s
WatchdogSignal=SIGTERM
TimeoutAbortSec=15s
TimeoutStopSec=15s
Restart=always
RestartSec=5s
LogNamespace=okuru
StandardOutput=journal
StandardError=journal
RuntimeDirectory=Okuru
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
Alias=Okuru.service
